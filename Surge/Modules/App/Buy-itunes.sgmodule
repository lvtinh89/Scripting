[MITM]
hostname = %APPEND% buy.itunes.apple.com

[Map Local]
#^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt$ data="https://raw.githubusercontent.com/lvtinh89/Scripting/master/Surge/Modules/App/iTunes.js"

[Script]
iTunes = type=http-response, pattern=^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$, script-path=https://raw.githubusercontent.com/lvtinh89/Scripting/refs/heads/master/Surge/Modules/App/iTunes.js, requires-body=true, max-size=-1, timeout=60
