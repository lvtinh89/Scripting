#!name=Surge 👉Revenuecat🐈‍⬛App
#!category=Surge 🐍lvtinh89
#!desc= Mở khoá các ứng dụng của Revenuecat(1. Trial 2. open Setting > AppleID > Supscriptions > Cancer. 3 Restore Purchase) Unlock Vsco, Noto, pillow, Spark mail, 1Blocker, darkroom, Planny, Widgetsmith, Grow, Anybox, Scanner Pro, iPTV+, Happy: Days, Forza Football, Not Boring,..

[MITM]
hostname = %APPEND% sub.store, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.rc-backup.com, buy.itunes.apple.com

[URL Rewrite]
^https:\/\/api\.lianjiu\.fun\/app\/api\/v1\/profile _ reject

[Header Rewrite]
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Map Local]
^https:\/\/firebaseremoteconfig\.googleapis\.com\/v\d\/projects data="https://raw.githubusercontent.com/lvtinh89/Scripting/master/Surge/Mock/firebase.json"

[Script]
Sub-Store Core=type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js,requires-body=true,timeout=120
Sub-Store Simple=type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js,requires-body=true
Sub-Store Sync=type=cron,cronexp=0 0 * * *,wake-system=1,timeout=120,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js

#Revenuecat-系列
Revenuecat_1 = type=http-response,engine=webview,script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),max-size=0,requires-body=true,timeout=10,script-update-interval=0,enable=true
Revenuecat_2 = type=http-request,engine=webview,script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),max-size=0,timeout=10,script-update-interval=0,enable=true
